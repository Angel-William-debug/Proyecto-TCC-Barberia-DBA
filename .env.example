# Plantilla de credenciales. Copiar a .env y completar con los valores reales.
# El archivo .env esta ignorado por git y nunca debe subirse al repo.

# Personal Access Token del CLI -> https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Password de la base de datos del proyecto
# Dashboard -> Project Settings -> Database -> Reset database password
SUPABASE_DB_PASSWORD=
